{
  "name": "heicrit",
  "version": "0.1.1",
  "description": "HeiCrit - Critical Apparatus Editor",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "dist:publish": "electron-builder --publish=always"
  },
  "author": {
    "name": "Gustavo Fernández Riva",
    "email": "gustavo.fernandez.riva@ub.uni-heidelberg.de"
  },
  "homepage": "https://github.com/GusRiva/heicrit",
  "repository": {
    "type": "git",
    "url": "https://github.com/GusRiva/heicrit.git"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.heicrit.app",
    "productName": "HeiCrit",
    "icon": "electron/assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "venv",
        "to": "venv"
      },
      {
        "from": "heipy",
        "to": "heipy"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "asarUnpack": [
      "**/backend/**/*",
      "**/venv/**/*",
      "**/heipy/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "GusRiva",
      "repo": "heicrit"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.png",
      "artifactName": "HeiCrit.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico",
      "artifactName": "HeiCrit-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.xz"
      ],
      "icon": "electron/assets/icon.png",
      "artifactName": "HeiCrit.${ext}"
    }
  }
}
