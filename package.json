{
  "name": "heicrit",
  "version": "1.0.0",
  "description": "HeiCrit - Critical Apparatus Editor",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never"
  },
  "author": {
    "name": "HeiCrit Team",
    "email": "contact@heicrit.org"
  },
  "homepage": "https://github.com/heicrit/heicrit",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.heicrit.app",
    "productName": "HeiCrit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "venv",
        "to": "venv"
      },
      {
        "from": "heipy",
        "to": "heipy"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "asarUnpack": [
      "**/backend/**/*",
      "**/venv/**/*",
      "**/heipy/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.xz"
      ]
    }
  }
}